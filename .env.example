# ==============================================================================
# CH EDTECH - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables for your local development environment.
# NEVER commit your actual .env file or put production secrets here!
# ==============================================================================

# --- System & Application Profile ---
APP_NAME=CH-EdTech
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:5175
API_URL=http://localhost:8085

# --- Network & Service Ports (Configured to prevent local conflicts) ---
# Note: 5432 is commonly used by local Postgres; CH_EdTech uses 5434 on host
POSTGRES_PORT=5434
SERVER_PORT=8085
FRONTEND_PORT=5175
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# --- PostgreSQL & pgvector Database Configuration ---
POSTGRES_HOST=localhost
POSTGRES_DB=ch_edtech_db
POSTGRES_USER=ch_edtech_user
POSTGRES_PASSWORD=replace_with_strong_db_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/ch_edtech_db

# --- Security & JWT Authentication ---
# Generate a secure 512-bit HMAC secret in production (minimum 64 characters)
JWT_SECRET=replace_with_at_least_64_characters_random_secure_secret_key_for_development_only
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# --- Storage Configuration (Development: MinIO / Production: Cloudflare R2) ---
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_DOCUMENTS=ch-edtech-documents
STORAGE_BUCKET_PUBLIC=ch-edtech-public
STORAGE_ACCESS_KEY=replace_with_minio_access_key
STORAGE_SECRET_KEY=replace_with_minio_secret_key
STORAGE_USE_PATH_STYLE=true

# --- Vector Database & AI Configuration ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
AI_PROVIDER_API_KEY=replace_with_ai_provider_api_key

# --- Monitoring & Observability ---
ACTUATOR_METRICS_ENABLED=true
PROMETHEUS_ENABLED=true
LOKI_ENDPOINT=http://localhost:3100/loki/api/v1/push
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password

# --- Cloudflare Configuration (Production Reference) ---
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_TUNNEL_TOKEN=

